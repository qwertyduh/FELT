*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/
e2e/
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Platform / tooling local state
.vercel/
.railway/
supabase/tests/
supabase/.temp/
supabase/.branches/
.claude/settings.local.json

# Logs
*.log
npm-debug.log*

